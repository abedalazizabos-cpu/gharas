# إعدادات الاستضافة: انسخ هذا الملف باسم .env على الخادم وعدّل القيم المعلّمة بـ «غيّر».
APP_NAME="مركز غراس"
APP_ENV=production
APP_KEY=
# يجب أن تبقى false على الخادم: لا تُظهر تفاصيل الأخطاء للزوار.
APP_DEBUG=false
# غيّر: رابط الموقع الحقيقي، ويبدأ بـ https بعد تفعيل شهادة SSL.
APP_URL=https://example.com
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=Asia/Riyadh
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# غيّر: بيانات قاعدة البيانات من لوحة الاستضافة.
DB_DATABASE=gharas
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# تُرسل جلسة الدخول عبر https فقط.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# الملفات أسرع من قاعدة البيانات للكاش على الاستضافة العادية.
CACHE_STORE=file

# غيّر: بريد الاستضافة إن أردت إرسال رسائل استعادة كلمة المرور.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
